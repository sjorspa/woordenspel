@page "/"
@implements IDisposable
@inject ApiClient Api
@inject AuthState Auth
@inject IGameUpdates Updates
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>Woordenspel</PageTitle>

<section class="card">
    <h1>Nieuw blitzspel</h1>
    @if (Auth.User is { } me)
    {
        <p class="muted">
            Jouw naam is <strong class="own-name">@me.Username</strong>.
            @(me.IsGuest ? "Geef die aan je tegenstander, zodat die jou kan uitdagen." : "Daarmee kunnen anderen jou uitdagen.")
        </p>
    }

    <button class="wide" disabled="@_busy" @onclick="StartOpenGameAsync">Open spel starten</button>
    <p class="muted small">Iedereen die online is kan meedoen. De klok begint pas als er een tegenstander is.</p>

    <div class="divider"><span>of daag iemand uit</span></div>

    <form class="inline" @onsubmit="ChallengeAsync" @onsubmit:preventDefault="true">
        <input @bind="_opponent" placeholder="Gebruikersnaam" aria-label="Tegenstander" required />
        <button type="submit" disabled="@_busy">Uitdagen</button>
    </form>

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
</section>

<section class="card">
    <h2>Wachten op een tegenstander</h2>
    @if (_seeks is null)
    {
        <p class="muted">Laden…</p>
    }
    else if (_seeks.Count == 0)
    {
        <p class="muted">Er wacht nu niemand. Start zelf een open spel!</p>
    }
    else
    {
        <ul class="seek-list">
            @foreach (var seek in _seeks)
            {
                var id = seek.Id;
                <li class="@SeekClass(seek)">
                    <span class="seek-text">@SeekText(seek)</span>
                    @if (seek.IsMine)
                    {
                        <span class="waiting">wacht…</span>
                        <button class="secondary" disabled="@_busy" @onclick="() => CancelAsync(id)">Annuleren</button>
                    }
                    else
                    {
                        <button disabled="@_busy" @onclick="() => JoinAsync(id)">@(seek.OpponentId is null ? "Meedoen" : "Accepteren")</button>
                    }
                </li>
            }
        </ul>
    }
</section>

@if (_games is not null)
{
    <GameList Title="Bezig" Games="Running" ViewerId="ViewerId" ReceivedAt="_receivedAt" Empty="Je hebt geen lopende spellen." />
    <GameList Title="Afgelopen" Games="Finished" ViewerId="ViewerId" ReceivedAt="_receivedAt" Empty="Nog geen afgelopen spellen." />
}

@code {
    private IReadOnlyList<GameSummaryDto>? _games;
    private IReadOnlyList<SeekDto>? _seeks;
    private DateTimeOffset _receivedAt;
    private string _opponent = string.Empty;
    private string? _error;
    private bool _busy;

    private Guid ViewerId => Auth.User?.UserId ?? Guid.Empty;

    private IReadOnlyList<GameSummaryDto> Running => _games!.Where(g => g.Status == GameStatus.InProgress).ToList();

    private IReadOnlyList<GameSummaryDto> Finished => _games!.Where(g => g.Status == GameStatus.Finished).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Navigation.NavigateTo("login");
            return;
        }

        Updates.GameUpdated += OnGameUpdated;
        Updates.SeeksChanged += LoadSeeksAsync;
        Updates.Reconnected += LoadAllAsync;
        await LoadAllAsync();
    }

    public void Dispose()
    {
        Updates.GameUpdated -= OnGameUpdated;
        Updates.SeeksChanged -= LoadSeeksAsync;
        Updates.Reconnected -= LoadAllAsync;
    }

    private async Task LoadAllAsync()
    {
        await LoadSeeksAsync();
        await LoadGamesAsync();
    }

    private Task OnGameUpdated(GameDto _) => LoadGamesAsync();

    private Task LoadGamesAsync() => LoadAsync(async () =>
    {
        _games = await Api.ListGamesAsync();
        _receivedAt = Time.GetUtcNow();
    });

    private Task LoadSeeksAsync() => LoadAsync(async () => _seeks = await Api.ListSeeksAsync());

    private async Task LoadAsync(Func<Task> load)
    {
        try
        {
            await load();
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
            if (!Auth.IsLoggedIn)
            {
                Navigation.NavigateTo("login");
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task StartOpenGameAsync() => RunAsync(async () =>
    {
        await Api.CreateSeekAsync(opponent: null);
        await LoadSeeksAsync();
    });

    private Task ChallengeAsync() => RunAsync(async () =>
    {
        await Api.CreateSeekAsync(_opponent.Trim());
        _opponent = string.Empty;
        await LoadSeeksAsync();
    });

    private Task JoinAsync(Guid seekId) => RunAsync(async () =>
    {
        var game = await Api.JoinSeekAsync(seekId);
        Navigation.NavigateTo($"games/{game.Id}");
    });

    private Task CancelAsync(Guid seekId) => RunAsync(async () =>
    {
        await Api.CancelSeekAsync(seekId);
        await LoadSeeksAsync();
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
            await LoadSeeksAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string SeekClass(SeekDto seek) =>
        seek.IsMine ? "mine" : seek.OpponentId is not null ? "challenge" : string.Empty;

    private static string SeekText(SeekDto seek) => (seek.IsMine, seek.OpponentName) switch
    {
        (true, null) => "Jouw open spel",
        (true, { } opponent) => $"Je daagde {opponent} uit",
        (false, null) => $"{seek.CreatorName} zoekt een tegenstander",
        (false, _) => $"{seek.CreatorName} daagt je uit!",
    };
}
